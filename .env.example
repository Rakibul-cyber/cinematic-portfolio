# Copy this file to .env.local only when the relevant implementation phase begins.
# Values are intentionally empty. Never commit credentials or real configuration.

# Application (Phase 1+)
NEXT_PUBLIC_SITE_URL=

# Database and authentication (Phase 2)
#
# DATABASE_URL           Neon *pooled* connection string (host contains "-pooler").
#                        Used by the running application through the Prisma Neon
#                        driver adapter.
# DATABASE_URL_UNPOOLED  Neon *direct* connection string (no "-pooler"). Used by
#                        Prisma Migrate only; PgBouncer cannot serve the
#                        session-level statements migrations need.
# NEON_BRANCH            Neon branch the local `neon.ts` policy selected. Written
#                        by the Neon CLI; informational.
#
# Both connection strings are credentials. Never expose them through NEXT_PUBLIC_*.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# BETTER_AUTH_SECRET  Signs and encrypts sessions and cookies. Must be at least
#                     32 characters of high-entropy random data, unique per
#                     environment. Generate with:
#                       node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# BETTER_AUTH_URL     Absolute origin of this application, e.g.
#                     http://localhost:3000 locally.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Set only for a single `npm run admin:bootstrap` invocation, in your shell —
# not in this file and not in .env.local. See README "First administrator".
# ADMIN_BOOTSTRAP_PASSWORD=

# Cloudflare R2 media storage (Phase 3)
# Server-only credentials for a dedicated development bucket. Grant Object Read
# & Write for that bucket only. R2_PUBLIC_BASE_URL is the public read origin.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Transactional email (Phase 7)
#
# Leave every value empty to run without email. Inquiries are still stored and
# the public form still succeeds; each delivery is recorded as SKIPPED rather
# than pretending a message was sent. Setting some but not all of these is
# treated as a misconfiguration and warned about in production.
#
# RESEND_API_KEY          Server-only Resend API key. Never expose it through a
#                         NEXT_PUBLIC_ variable, a CMS setting, or the database.
# EMAIL_FROM              Verified Resend sender, as `Studio Name <you@your-domain>`
#                         or a bare address. Must be on a domain verified in Resend.
# EMAIL_REPLY_TO          Optional. Where customer replies to the acknowledgment
#                         go. The studio notification always replies to the visitor.
# EMAIL_ADMIN_RECIPIENTS  Comma-separated studio recipients for the inquiry
#                         notification. Every entry must be valid.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_ADMIN_RECIPIENTS=

# Bot protection (Phase 8). The site key is intentionally public; the other
# values are server-only. RATE_LIMIT_HMAC_SECRET must be a separate random
# 32+ character value, never BETTER_AUTH_SECRET.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
RATE_LIMIT_HMAC_SECRET=

# SEO (Phase 9)
#
# NEXT_PUBLIC_SITE_URL above is the deployment origin and is what makes
# canonical URLs, Open Graph, JSON-LD, the sitemap, and robots.txt absolute.
# Without it those degrade quietly rather than guessing a hostname: the sitemap
# is empty, robots.txt omits its sitemap reference, and canonicals stay
# relative. BETTER_AUTH_URL is used as a fallback, since it is already required
# to be this application's absolute origin.

# Analytics (Phase 9). Entirely optional and cookieless; leave empty to run
# with no analytics at all, which loads no script and sends no request.
#
# UMAMI_WEBSITE_ID / NEXT_PUBLIC_UMAMI_WEBSITE_ID
#     The Umami website id. It is public by nature -- it is rendered as an
#     attribute on a script tag -- so either spelling is safe; the NEXT_PUBLIC_
#     one is canonical. Setting neither disables analytics.
# NEXT_PUBLIC_UMAMI_SCRIPT_URL
#     Tracker URL. Defaults to Umami Cloud; set it to your own instance's
#     /script.js when self-hosting. Must be HTTPS or analytics stays disabled.
UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=

# Error monitoring (Phase 9), through the official @sentry/nextjs SDK.
#
# Entirely optional and production-only. Leave every value empty to run with no
# monitoring: the application builds, runs, and sends nothing. In development
# nothing is ever sent, with or without a DSN. No Sentry account is needed to
# develop, build, test, or verify this project.
#
# --- Browser-visible (inlined into the client bundle at build time) ----------
#
# NEXT_PUBLIC_SENTRY_DSN
#     The one DSN, used by the browser, Node, and Edge runtimes alike. A DSN is
#     public by design: every Sentry browser SDK embeds it in the client bundle,
#     so a second unprefixed copy would protect nothing and could drift. Setting
#     it also adds that DSN's ingest origin -- and nothing else -- to the
#     Content-Security-Policy's connect-src.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT
#     Optional label, e.g. "production" or "staging". Defaults to "production".
# NEXT_PUBLIC_SENTRY_RELEASE
#     Optional release identifier, e.g. a commit SHA.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=

# --- Build-time only, and deployment-only (Phase 10) ------------------------
#
# These three are read by next.config.ts during `next build` to upload source
# maps so production stack traces are readable. They are never referenced by
# application code and never reach the browser. Leave them empty here: without
# SENTRY_AUTH_TOKEN the build skips the upload entirely, which is the normal
# local and CI setup.
#
# SENTRY_AUTH_TOKEN  A SECRET. Set it only in the Netlify UI (or CI secrets),
#                    never in this file, in .env.local, or in a commit.
# SENTRY_ORG         Sentry organization slug.
# SENTRY_PROJECT     Sentry project slug.
SENTRY_ORG=
SENTRY_PROJECT=
