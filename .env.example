# Copy this file to .env.local only when the relevant implementation phase begins.
# Values are intentionally empty. Never commit credentials or real configuration.

# Application (Phase 1+)
NEXT_PUBLIC_SITE_URL=

# Database and authentication (Phase 2)
#
# DATABASE_URL           Neon *pooled* connection string (host contains "-pooler").
#                        Used by the running application through the Prisma Neon
#                        driver adapter.
# DATABASE_URL_UNPOOLED  Neon *direct* connection string (no "-pooler"). Used by
#                        Prisma Migrate only; PgBouncer cannot serve the
#                        session-level statements migrations need.
# NEON_BRANCH            Neon branch the local `neon.ts` policy selected. Written
#                        by the Neon CLI; informational.
#
# Both connection strings are credentials. Never expose them through NEXT_PUBLIC_*.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# BETTER_AUTH_SECRET  Signs and encrypts sessions and cookies. Must be at least
#                     32 characters of high-entropy random data, unique per
#                     environment. Generate with:
#                       node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# BETTER_AUTH_URL     Absolute origin of this application, e.g.
#                     http://localhost:3000 locally.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Set only for a single `npm run admin:bootstrap` invocation, in your shell —
# not in this file and not in .env.local. See README "First administrator".
# ADMIN_BOOTSTRAP_PASSWORD=

# Cloudflare R2 media storage (Phase 3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Email delivery (Phase 7)
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

# Bot protection (Phase 8)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics and error monitoring (Phase 9)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
