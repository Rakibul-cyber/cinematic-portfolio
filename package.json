{
  "name": "cinematic-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=react-server --test \"src/**/*.test.ts\"",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "auth:verify": "node scripts/verify-auth-flow.mjs",
    "media:verify": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-media-flow.ts",
    "cms:verify": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-cms-flow.ts",
    "public:verify": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-public-flow.ts",
    "admin:bootstrap": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/bootstrap-admin.ts"
  },
  "overrides": {
    "postcss": "8.5.26",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@neondatabase/serverless": "1.1.0",
    "@prisma/adapter-neon": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "motion": "^13.1.1",
    "next": "^15.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@neon/config": "^1.3.0",
    "@neon/env": "^1.2.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "dotenv": "17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.13",
    "typescript": "^5.9.3"
  }
}
