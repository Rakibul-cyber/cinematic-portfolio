{
  "name": "cinematic-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=react-server --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\" && tsx --test \"src/**/*.render-test.ts\"",
    "test:bundle": "tsx scripts/bundle/run.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/prisma-guarded.ts migrate-dev",
    "db:migrate:deploy": "tsx scripts/prisma-guarded.ts migrate-deploy",
    "db:migrate:status": "prisma migrate status",
    "db:studio": "tsx scripts/prisma-guarded.ts studio",
    "auth:verify": "node scripts/verify-auth-flow.mjs",
    "media:verify": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-media-flow.ts",
    "cms:verify": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-cms-flow.ts",
    "public:verify": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-public-flow.ts",
    "crm:verify": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-crm-flow.ts",
    "admin:bootstrap": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/bootstrap-admin.ts",
    "email:verify": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-email-flow.ts",
    "security:verify": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-security-flow.ts",
    "seo:verify": "tsx --env-file-if-exists=.env.local scripts/verify-seo-flow.ts",
    "analytics:verify": "tsx --env-file-if-exists=.env.local scripts/verify-analytics-flow.ts",
    "deploy:verify": "tsx --env-file-if-exists=.env.local scripts/verify-deploy-flow.ts",
    "integration:preflight": "tsx scripts/integration/run.ts preflight",
    "integration:identity": "tsx scripts/integration/run.ts identity",
    "integration:run": "tsx scripts/integration/run.ts run"
  },
  "overrides": {
    "postcss": "8.5.26",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@neondatabase/serverless": "1.1.0",
    "@prisma/adapter-neon": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "^10.75.2",
    "better-auth": "1.7.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "motion": "^13.1.1",
    "next": "^15.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.27.0",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@neon/config": "^1.3.0",
    "@neon/env": "^1.2.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "28.0.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "dotenv": "17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "jsdom": "28.1.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.13",
    "typescript": "^5.9.3"
  }
}
