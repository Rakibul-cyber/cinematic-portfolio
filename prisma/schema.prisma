// Cinematic Portfolio database schema.
//
// Phase 2 models authentication, roles, and audit. Phase 3 adds only media.
//
// The Better Auth core tables (user, session, account, verification) follow the
// field contract expected by the Better Auth Prisma adapter, with two
// deliberate additions: `role` on `user`, and extra indexes.
//
// After upgrading Better Auth, re-check that contract by printing the shape it
// expects and diffing it against this file:
//
//   npx auth@<installed version> generate --config <a probe config> -o out.prisma
//
// The CLI refuses any config that imports `server-only`, so point it at a
// throwaway config that mirrors `database`, `emailAndPassword`,
// `user.additionalFields`, and `plugins` from src/server/auth/config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Application role for the private admin area.
///
/// Roles are server-owned. A role is never accepted from client input and is
/// always read back from the database before an authorization decision.
enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum MediaKind {
  IMAGE
}

enum StorageProvider {
  R2
}

enum MediaVariantName {
  THUMBNAIL
  W640
  W1280
  W1920
  MASTER
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
}

enum ProjectMediaRole {
  COVER
  HERO
  GALLERY
}

/// Provider of a long-form video shown on the public site.
///
/// Long-form portfolio video is hosted with a video provider rather than in R2.
/// Only the provider and the provider's own identifier are stored: never iframe
/// markup, embed scripts, or arbitrary URLs. The public player builds the embed
/// URL itself, so changing provider or privacy domain is a code change in one
/// helper rather than a content migration.
enum VideoProvider {
  YOUTUBE
  VIMEO
  EXTERNAL
}

enum InquiryStatus {
  NEW
  CONTACTED
  DISCUSSION
  QUOTE_SENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// The transactional emails a submitted inquiry can produce.
///
/// Deliberately closed and small. Phase 7 sends exactly these two messages;
/// marketing, status-change, quote, and reminder emails are out of scope.
enum EmailDeliveryType {
  INQUIRY_ADMIN_NOTIFICATION
  INQUIRY_CUSTOMER_ACKNOWLEDGMENT
}

/// Lifecycle of one delivery attempt.
///
/// `ACCEPTED` means the provider accepted the API request and returned a
/// message id. It is deliberately not called `SENT` or `DELIVERED`: without
/// provider webhooks the application has no evidence the message reached an
/// inbox, and a status name should not claim more than is known.
///
/// `PROCESSING` doubles as the claim: a row exists only because some request
/// took ownership of that delivery, which is what stops two concurrent attempts
/// from both calling the provider.
///
/// `SKIPPED` records an honest non-attempt, used when email is not configured.
enum EmailDeliveryStatus {
  PROCESSING
  ACCEPTED
  FAILED
  SKIPPED
}

/// Administrative user. This is the Better Auth `user` table extended with the
/// application role. No public sign-up exists, so every row is created by the
/// bootstrap script or by an already-authorized administrator.
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          AdminRole @default(EDITOR)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  auditLogs AuditLog[]
  media     Media[]
  customerNotes CustomerNote[]
  inquiryStatusChanges InquiryStatusHistory[]

  @@index([role])
  @@map("user")
}

model Media {
  id              String          @id @default(uuid())
  kind            MediaKind       @default(IMAGE)
  originalName    String
  mimeType        String
  sizeBytes       Int
  width           Int
  height          Int
  altText         String?
  caption         String?
  storageProvider StorageProvider @default(R2)
  bucket          String
  objectKey       String          @unique
  blurDataUrl     String?
  createdByUserId String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  createdBy User           @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  variants  MediaVariant[]
  projects  ProjectMedia[]

  @@index([createdAt])
  @@index([createdByUserId])
  @@map("media")
}

model PortfolioCategory {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]

  @@index([isActive, sortOrder])
  @@map("portfolio_category")
}

model Project {
  id             String            @id @default(uuid())
  title          String
  slug           String            @unique
  summary        String
  description    String
  clientName     String?
  location       String?
  projectDate    DateTime?
  categoryId     String
  status         PublicationStatus @default(DRAFT)
  featured       Boolean           @default(false)
  sortOrder      Int               @default(0)
  seoTitle       String?
  seoDescription String?
  videoProvider  VideoProvider?
  videoId        String?
  videoTitle     String?
  publishedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  category PortfolioCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  media    ProjectMedia[]

  @@index([status, sortOrder])
  @@index([categoryId])
  @@map("project")
}

model ProjectMedia {
  projectId String
  mediaId   String
  role      ProjectMediaRole @default(GALLERY)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([projectId, mediaId])
  @@index([projectId, sortOrder])
  @@index([mediaId])
  @@map("project_media")
}

model Service {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  shortDescription String
  description      String
  priceLabel       String?
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  inquiries        Inquiry[]

  @@index([isActive, sortOrder])
  @@map("service")
}

model Customer {
  id              String   @id @default(uuid())
  name            String
  email           String
  normalizedEmail String   @unique
  phone           String?
  whatsapp        String?
  company         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  anonymizedAt    DateTime?

  inquiries Inquiry[]
  notes     CustomerNote[]

  @@index([updatedAt])
  @@map("customer")
}

model Inquiry {
  id                 String        @id @default(uuid())
  submissionToken    String        @unique
  customerId         String
  serviceId          String?
  serviceNameSnapshot String?
  nameSnapshot       String
  emailSnapshot      String
  phoneSnapshot      String?
  whatsappSnapshot   String?
  companySnapshot    String?
  projectType        String
  projectDate        DateTime?     @db.Date
  location           String?
  budgetLabel        String?
  message            String
  referralSource     String?
  status             InquiryStatus @default(NEW)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  anonymizedAt       DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  statusHistory InquiryStatusHistory[]
  emailDeliveries EmailDelivery[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([serviceId])
  @@index([createdAt])
  @@map("inquiry")
}

/// Short-lived, pseudonymous fixed-window counters for public abuse controls.
model RateLimitBucket {
  id          String   @id @default(uuid())
  scope       String
  keyHash     String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, keyHash, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_bucket")
}

model InquiryStatusHistory {
  id              String        @id @default(uuid())
  inquiryId       String
  fromStatus      InquiryStatus?
  toStatus        InquiryStatus
  changedByUserId String?
  createdAt       DateTime      @default(now())

  inquiry   Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([inquiryId, createdAt])
  @@map("inquiry_status_history")
}

/// One transactional email attempt for one inquiry.
///
/// The unique constraint on (inquiryId, type) is the idempotency guarantee: a
/// replayed submission cannot create a second delivery row, so it cannot
/// trigger a second provider call. Creating the row *is* claiming the send.
///
/// No rendered subject, HTML, or text is stored. The Inquiry snapshot already
/// holds everything the templates need, so re-storing the message would only
/// duplicate personal data. `lastErrorCode` holds a short sanitized category,
/// never a raw provider response.
model EmailDelivery {
  id                String              @id @default(uuid())
  inquiryId         String
  type              EmailDeliveryType
  status            EmailDeliveryStatus @default(PROCESSING)
  /// Provider actually contacted, or null when nothing was attempted.
  provider          String?
  providerMessageId String?
  attemptCount      Int                 @default(0)
  /// Short sanitized failure category. Never a raw provider payload.
  lastErrorCode     String?
  /// When the provider accepted the request. Not proof of inbox delivery.
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@unique([inquiryId, type])
  @@index([status, updatedAt])
  @@map("email_delivery")
}

model CustomerNote {
  id           String   @id @default(uuid())
  customerId   String
  authorUserId String?
  body         String
  createdAt    DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@map("customer_note")
}

model Testimonial {
  id          String   @id @default(uuid())
  quote       String
  authorName  String
  authorRole  String?
  company     String?
  projectName String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("testimonial")
}

model Page {
  id             String   @id @default(uuid())
  key            String   @unique
  title          String
  eyebrow        String?
  body           String
  seoTitle       String?
  seoDescription String?
  updatedAt      DateTime @updatedAt

  @@map("page")
}

model SiteSetting {
  id                    String   @id @default("primary")
  studioName            String
  tagline               String?
  contactEmail          String?
  contactPhone          String?
  whatsappNumber        String?
  locationText          String?
  footerCopyright       String?
  defaultSeoTitle       String?
  defaultSeoDescription String?
  showreelProvider      VideoProvider?
  showreelVideoId       String?
  showreelTitle         String?
  updatedAt             DateTime       @updatedAt

  @@map("site_setting")
}

model SocialLink {
  id        String   @id @default(uuid())
  platform  String
  label     String
  url       String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("social_link")
}

model MediaVariant {
  id        String           @id @default(uuid())
  mediaId   String
  variant   MediaVariantName
  width     Int
  height    Int
  mimeType  String
  sizeBytes Int
  objectKey String           @unique
  createdAt DateTime         @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, variant])
  @@index([mediaId])
  @@map("media_variant")
}

/// Better Auth session. Deleting a user removes their sessions so revoking an
/// account immediately revokes access.
model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

/// Better Auth account. For this private admin application only the credential
/// provider is used, so `password` holds the Better Auth password hash.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, accountId])
  @@map("account")
}

/// Better Auth verification tokens (email verification, password reset).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

/// Audit foundation for privileged administrative actions.
///
/// `actorUserId` is nullable and set to NULL when a user is deleted so the audit
/// history survives account removal. `metadata` is deliberately `Json` because
/// entries describe heterogeneous actions across future admin features; it must
/// never contain passwords, tokens, secrets, or connection strings.
model AuditLog {
  id          String   @id @default(uuid())
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  actorEmail  String?
  actorUserId String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_log")
}
